ARG BASE_IMAGE=golang:alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414

# Builder Stage
FROM ${BASE_IMAGE} AS builder

RUN apk add --no-cache ca-certificates tzdata git alpine-sdk

WORKDIR /gogeneratecftoken

ARG SOURCE_REF=main
RUN git clone --branch "${SOURCE_REF}" https://github.com/nicholas-fedor/gogeneratecftoken.git .

ARG VERSION=dev
ARG COMMIT_SHA=unknown
ARG BUILD_TIME=unknown

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -a \
    -ldflags "\
    -s -w \
    -X github.com/nicholas-fedor/gogeneratecftoken/v2/internal/metadata.Version=${VERSION} \
    -X github.com/nicholas-fedor/gogeneratecftoken/v2/internal/metadata.CommitSHA=${COMMIT_SHA} \
    -X github.com/nicholas-fedor/gogeneratecftoken/v2/internal/metadata.BuildTime=${BUILD_TIME} \
    " \
    -o ./bin/gogeneratecftoken \
    .

# Final Build
FROM scratch

LABEL \
    "org.opencontainers.image.documentation"="https://github.com/nicholas-fedor/gogeneratecftoken" \
    "org.opencontainers.image.source"="https://github.com/nicholas-fedor/gogeneratecftoken" \
    "org.opencontainers.image.licenses"="AGPLv3" \
    "org.opencontainers.image.title"="gogeneratecftoken" \
    "org.opencontainers.image.description"="A simple CLI tool for generating Cloudflare API tokens."

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

COPY --chmod=0755 --from=builder /gogeneratecftoken/bin/gogeneratecftoken /gogeneratecftoken

USER 65532:65532

ENTRYPOINT ["/gogeneratecftoken"]
